<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera permissions -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    
    <!-- Camera features -->
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".ReceiptScannerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ReceiptScanner"
        tools:targetApi="31">
        
        <!-- Camera Activity -->
        <activity
            android:name=".presentation.ui.camera.CameraActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ReceiptScanner" />
            
        <!-- Image Preview Activity -->
        <activity
            android:name=".presentation.ui.camera.ImagePreviewActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ReceiptScanner" />
            
        <!-- Gallery Activity -->
        <activity
            android:name=".presentation.ui.gallery.GalleryActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ReceiptScanner" />
            
        <!-- Manual Entry Activity -->
        <activity
            android:name=".presentation.ui.manual.ManualEntryActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ReceiptScanner" />
            
        <!-- Main Activity -->
        <activity
            android:name=".presentation.ui.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.ReceiptScanner" />
            
        <!-- Simple Test Activity (Launcher for Development) -->
        <activity
            android:name=".presentation.ui.SimpleTestActivity"
            android:exported="true"
            android:theme="@style/Theme.ReceiptScanner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
            
    </application>

</manifest>